# Flask application entrypoint and local development mode.
FLASK_APP=app
FLASK_ENV=development

# Local-only placeholder secrets. Real deployments must override these values.
SECRET_KEY=change-me-change-me-change-me-32-bytes

# Postgres connection used by the app and migration runner.
DATABASE_URL=postgresql://miniten:miniten@localhost:5432/miniten

# Server-side secret used when hashing project API keys.
API_KEY_HASH_SECRET=change-me-change-me-api-key-hash-secret

# Kubernetes and vLLM defaults used when model deployments omit explicit values.
K8S_NAMESPACE_PREFIX=miniten
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_CPU_IMAGE=vllm/vllm-openai-cpu:latest-x86_64
# Optional vLLM CLI device override. Leave empty in production unless a cluster
# needs an explicit value such as cpu, cuda, neuron, or tpu.
VLLM_DEVICE=
# Local kind-only compatibility path for GPU smoke tests on Docker Desktop/WSL2.
# Leave false in normal and production deployments.
LOCAL_KIND_GPU_DRIVER_MOUNT=false
LOCAL_KIND_GPU_DRIVER_PATH=/usr/local/nvidia/lib64
# CPU vLLM uses this vLLM flag to size CPU KV-cache memory. Keep this low for
# Docker Desktop/kind where the Kubernetes node has limited free memory.
VLLM_CPU_MEMORY_UTILIZATION=0.15
VLLM_LOGGING_LEVEL=
DEFAULT_MODEL_REPLICAS=1
DEFAULT_HPA_MIN_REPLICAS=1
DEFAULT_HPA_MAX_REPLICAS=3
DEFAULT_HPA_TARGET_CPU_UTILIZATION=70
DEFAULT_PVC_SIZE=20Gi

# Maximum time Flask waits for an upstream vLLM inference response.
INFERENCE_UPSTREAM_TIMEOUT_SECONDS=300

# Local host-run Flask can use kubectl port-forward for real-k8s smoke inference.
INFERENCE_LOCAL_PORT_FORWARD_URL=http://127.0.0.1:18080

# Local Flask development server mode. CI sets this false to avoid the reloader.
API_DEBUG=true

# Set true for local/CI worker smoke tests that should not call Kubernetes.
WORKER_DRY_RUN=false

# Docker Compose worker kubeconfig mount. For real local Kubernetes mutations,
# setup scripts generate .local/kube/config for Docker Compose.
KUBECONFIG_DIR=.local/kube

# Local kind cluster name created by make setup-env and deleted by make clean-kind/clean-all.
MINITEN_KIND_CLUSTER_NAME=miniten

# Optional token mounted into model pods as a Kubernetes Secret for gated models.
HUGGING_FACE_TOKEN=

# Tiny image used by make test-local-k8s to validate Kubernetes plumbing quickly.
K8S_SMOKE_TEST_IMAGE=python:3.12-alpine
K8S_SMOKE_TEST_MODEL_ID=miniten/smoke-openai-compatible

# Slower optional real-vLLM smoke test knobs used by make test-local-vllm.
# The API selects VLLM_CPU_IMAGE for 0 GPUs and VLLM_IMAGE for GPU deployments.
MINITEN_VLLM_TEST_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MINITEN_VLLM_TEST_JOB_POLLS=1800
MINITEN_VLLM_TEST_PORT_FORWARD_PORT=18080
MINITEN_VLLM_TEST_CPU_REQUEST=2
MINITEN_VLLM_TEST_CPU_LIMIT=4
MINITEN_VLLM_TEST_MEMORY_REQUEST=4Gi
MINITEN_VLLM_TEST_MEMORY_LIMIT=12Gi
MINITEN_VLLM_TEST_GPU_COUNT=0
MINITEN_VLLM_TEST_DEVICE=cpu
MINITEN_VLLM_TEST_DTYPE=auto
MINITEN_VLLM_TEST_MAX_MODEL_LEN=512

# Optional GPU vLLM smoke test overrides used by make test-local-vllm-gpu.
# The Kubernetes node must advertise allocatable nvidia.com/gpu before this
# target can run. A host GPU alone is not enough.
MINITEN_GPU_PROBE_IMAGE=nvidia/cuda:12.4.1-base-ubuntu22.04
# Current prebuilt vLLM GPU images require modern NVIDIA compute capability.
# Keep this aligned with the vLLM image/version used by VLLM_IMAGE.
MINITEN_VLLM_GPU_MIN_COMPUTE_CAPABILITY=7.5
MINITEN_VLLM_GPU_TEST_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MINITEN_VLLM_GPU_TEST_GPU_COUNT=1
MINITEN_VLLM_GPU_TEST_DEVICE=cuda

# Process logging verbosity. Use DEBUG locally when investigating behavior.
LOG_LEVEL=INFO
